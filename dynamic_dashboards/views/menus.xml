<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- We will define the action for the OWL dashboard view later in python/js -->
    <record id="action_dynamic_dashboard_main" model="ir.actions.client">
        <field name="name">My Dashboards</field>
        <field name="tag">dynamic_dashboard_action</field>
    </record>

    <!-- Top Menu -->
    <menuitem id="menu_dynamic_dashboard_root"
              name="Dashboards"
              web_icon="dynamic_dashboards,static/description/icon.png"
              sequence="1"/>

    <!-- Main View Menu -->
    <menuitem id="menu_dynamic_dashboard_view"
              name="My Dashboards"
              parent="menu_dynamic_dashboard_root"
              action="action_dynamic_dashboard_main"
              sequence="10"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_dynamic_dashboard_config"
              name="Configuration"
              parent="menu_dynamic_dashboard_root"
              sequence="100"/>

    <menuitem id="menu_dynamic_dashboard_settings"
              name="Dashboards Setup"
              parent="menu_dynamic_dashboard_config"
              action="action_dynamic_dashboard_config"
              sequence="10"/>
</odoo>

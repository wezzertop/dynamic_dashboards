<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dynamic_dashboard_item_form" model="ir.ui.view">
        <field name="name">dynamic.dashboard.item.form</field>
        <field name="model">dynamic.dashboard.item</field>
        <field name="arch" type="xml">
            <form string="Dashboard Item">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Widget Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Total Revenue"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Layout &amp; Type">
                            <field name="dashboard_id" invisible="context.get('default_dashboard_id')"/>
                            <field name="chart_type"/>
                            <field name="col_span"/>
                        </group>
                        <group string="Data Source">
                            <field name="model_id"/>
                            <field name="domain" widget="domain" options="{'model': 'model_name'}"/>
                            <field name="model_name" invisible="1"/>
                        </group>
                    </group>
                    <group string="Chart Configuration" invisible="not model_id">
                        <group>
                            <field name="measure_field_id"/>
                            <field name="group_by_field_id" invisible="chart_type == 'kpi'"/>
                        </group>
                        <group>
                            <field name="date_field_id" invisible="chart_type == 'kpi'"/>
                            <field name="limit" invisible="chart_type == 'kpi'"/>
                        </group>
                    </group>
                    <!-- Live Preview Widget -->
                    <div class="mt-4 mb-4">
                        <field name="preview" widget="dashboard_item_preview" nolabel="1" colspan="2"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

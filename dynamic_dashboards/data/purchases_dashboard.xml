<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="dashboard_purchases_default" model="dynamic.dashboard">
        <field name="name">Procurement &amp; Purchases</field>
        <field name="theme_color">dark</field>
    </record>

    <!-- Line: Purchases trend -->
    <record id="item_purchase_trend" model="dynamic.dashboard.item">
        <field name="name">Purchasing Trend</field>
        <field name="dashboard_id" ref="dashboard_purchases_default"/>
        <field name="sequence">10</field>
        <field name="chart_type">line</field>
        <field name="col_span">8</field>
        <field name="model_id" search="[('model', '=', 'purchase.order')]"/>
        <field name="domain">[('state', 'in', ['purchase', 'done'])]</field>
        <field name="measure_field_id" search="[('model_id.model', '=', 'purchase.order'), ('name', '=', 'amount_total')]"/>
        <field name="date_field_id" search="[('model_id.model', '=', 'purchase.order'), ('name', '=', 'date_order')]"/>
    </record>

    <!-- Bar: Top Vendors -->
    <record id="item_purchase_vendors" model="dynamic.dashboard.item">
        <field name="name">Top Vendors</field>
        <field name="dashboard_id" ref="dashboard_purchases_default"/>
        <field name="sequence">20</field>
        <field name="chart_type">bar</field>
        <field name="col_span">4</field>
        <field name="model_id" search="[('model', '=', 'purchase.order')]"/>
        <field name="domain">[('state', 'in', ['purchase', 'done'])]</field>
        <field name="measure_field_id" search="[('model_id.model', '=', 'purchase.order'), ('name', '=', 'amount_total')]"/>
        <field name="group_by_field_id" search="[('model_id.model', '=', 'purchase.order'), ('name', '=', 'partner_id')]"/>
        <field name="limit">5</field>
    </record>
</odoo>

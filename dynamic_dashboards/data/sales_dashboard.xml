<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Main Dashboard -->
    <record id="dashboard_sales_default" model="dynamic.dashboard">
        <field name="name">Sales Overview</field>
        <field name="theme_color">blue</field>
    </record>

    <!-- KPI: Total Revenue -->
    <record id="item_sales_revenue_kpi" model="dynamic.dashboard.item">
        <field name="name">Total Confirmed Revenue</field>
        <field name="dashboard_id" ref="dashboard_sales_default"/>
        <field name="sequence">10</field>
        <field name="chart_type">kpi</field>
        <field name="col_span">4</field>
        <field name="model_id" search="[('model', '=', 'sale.order')]"/>
        <field name="domain">[('state', 'in', ['sale', 'done'])]</field>
        <field name="measure_field_id" search="[('model_id.model', '=', 'sale.order'), ('name', '=', 'amount_total')]"/>
    </record>

    <!-- KPI: Order Count -->
    <record id="item_sales_count_kpi" model="dynamic.dashboard.item">
        <field name="name">Confirmed Orders</field>
        <field name="dashboard_id" ref="dashboard_sales_default"/>
        <field name="sequence">20</field>
        <field name="chart_type">kpi</field>
        <field name="col_span">4</field>
        <field name="model_id" search="[('model', '=', 'sale.order')]"/>
        <field name="domain">[('state', 'in', ['sale', 'done'])]</field>
    </record>

    <!-- Line Chart: Revenue over time -->
    <record id="item_sales_trend" model="dynamic.dashboard.item">
        <field name="name">Revenue Trend (Monthly)</field>
        <field name="dashboard_id" ref="dashboard_sales_default"/>
        <field name="sequence">40</field>
        <field name="chart_type">line</field>
        <field name="col_span">8</field>
        <field name="model_id" search="[('model', '=', 'sale.order')]"/>
        <field name="domain">[('state', 'in', ['sale', 'done'])]</field>
        <field name="measure_field_id" search="[('model_id.model', '=', 'sale.order'), ('name', '=', 'amount_total')]"/>
        <field name="date_field_id" search="[('model_id.model', '=', 'sale.order'), ('name', '=', 'date_order')]"/>
    </record>

    <!-- Pie Chart: Top Salespeople -->
    <record id="item_sales_top_users" model="dynamic.dashboard.item">
        <field name="name">Top Salespersons</field>
        <field name="dashboard_id" ref="dashboard_sales_default"/>
        <field name="sequence">50</field>
        <field name="chart_type">pie</field>
        <field name="col_span">4</field>
        <field name="model_id" search="[('model', '=', 'sale.order')]"/>
        <field name="domain">[('state', 'in', ['sale', 'done'])]</field>
        <field name="measure_field_id" search="[('model_id.model', '=', 'sale.order'), ('name', '=', 'amount_total')]"/>
        <field name="group_by_field_id" search="[('model_id.model', '=', 'sale.order'), ('name', '=', 'user_id')]"/>
        <field name="limit">5</field>
    </record>
</odoo>
